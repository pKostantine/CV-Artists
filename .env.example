# The public Coptic Vine Artists client configuration. `npm run deploy` builds
# with these in the environment; copy this file to .env.local to override them
# locally.

# The cv-media-resolver Worker. Swap for a custom media domain if one is set up.
EXPO_PUBLIC_MEDIA_BASE_URL=https://cv-media-resolver.hrmpdd8d6c.workers.dev

EXPO_PUBLIC_UPLOAD_URL=https://cv-upload-authorizer.hrmpdd8d6c.workers.dev

# Signing in and the data: cv-api (src/services/userApi.ts);
# EXPO_PUBLIC_USER_API_URL defaults to https://api.copticvine.ca.
