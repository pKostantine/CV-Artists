{
  "expo": {
    "name": "Coptic Vine Artists",
    "slug": "cv-artists",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/coptic-vine-artists-icon.png",
    "scheme": "copticvineartists",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "icon": "./assets/images/coptic-vine-artists-icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9B93A",
        "foregroundImage": "./assets/images/coptic-vine-artists-android-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/coptic-vine-artists-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14301B",
          "image": "./assets/images/coptic-vine-seal.png",
          "imageWidth": 160
        }
      ],
      "expo-font"
    ]
  }
}
